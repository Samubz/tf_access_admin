# Local MailHog SMTP capture (see docker-compose.yml). Defaults match the
# docker-compose.yml service, so these are only needed to override.
MAILHOG_SMTP_ADDRESS=localhost
MAILHOG_SMTP_PORT=1025
# Local FCM-compatible push notification simulator (e.g. PushHog). Defaults to
# the real Firebase endpoint in code; set these to redirect to a local
# simulator in development. FCM_PROJECT_ID is not validated by PushHog.
FCM_BASE_URL=http://localhost:8090
FCM_PROJECT_ID=development
AWS_REGION=
AWS_S3_BUCKET=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=
PGDATABASE=

SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_ENABLE_STARTTLS_AUTO=false

APP_HOST=staging.eventli.cl
APP_PROTOCOL=https

DOKPLOY_HOST=false #to use a long domain like staging.eventli.cl, set this to true. Otherwise, use false for
CACHE_DATABASE_URL=
RAILS_SERVE_STATIC_FILES=true
RAILS_MASTER_KEY=xxxxxxxxxxxxxxx
